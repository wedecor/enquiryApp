rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function _userDoc() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    // Mirrors firestore.rules isActiveUser(): profile exists and isActive (legacy `active`) != false.
    function isActiveUser() {
      return isSignedIn()
        && firestore.exists(_userDoc())
        && firestore.get(_userDoc()).data.get('isActive', firestore.get(_userDoc()).data.get('active', true)) == true;
    }

    // Mirrors firestore.rules isAdmin(): role comes from the Firestore profile only.
    function isAdmin() {
      return isActiveUser()
        && firestore.get(_userDoc()).data.role == 'admin';
    }

    // Admins: full access. Staff: only when Firestore allows them to read the enquiry.
    function canAccessEnquiry(enquiryId) {
      return isAdmin() || isAssignedToEnquiry(enquiryId);
    }

    function isAssignedToEnquiry(enquiryId) {
      let enquiryPath = /databases/(default)/documents/enquiries/$(enquiryId);
      return isActiveUser()
        && firestore.exists(enquiryPath)
        && (
          firestore.get(enquiryPath).data.assignedTo == request.auth.uid
          || firestore.get(enquiryPath).data.createdBy == request.auth.uid
        );
    }

    function isValidAttachmentWrite() {
      return request.resource.size < 5 * 1024 * 1024
        && (
          !('contentType' in request.resource)
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    function isValidImageWrite() {
      return request.resource.size < 10 * 1024 * 1024
        && (
          !('contentType' in request.resource)
          || request.resource.contentType.matches('image/.*')
        );
    }

    match /attachments/{enquiryId}/{fileName} {
      allow read: if canAccessEnquiry(enquiryId);
      allow create, update: if canAccessEnquiry(enquiryId) && isValidAttachmentWrite();
      allow delete: if isAdmin();
    }

    match /enquiries/{enquiryId}/images/{fileName} {
      allow read: if canAccessEnquiry(enquiryId);
      allow create, update: if canAccessEnquiry(enquiryId) && isValidImageWrite();
      allow delete: if isAdmin();
    }
  }
}
