rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    
    function isActiveUser() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData.get('isActive', userData.get('active', true)) == true;
    }

    function isAdmin() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // Check if user is staff (not admin)
    function isStaff() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff";
    }
    
    // Staff may READ assigned enquiries in full (including totals/payment).
    // Write protection only — UI/export must hide financial data for staff (see csv_export_rbac).
    // eventDate stays staff-editable: the edit form lets staff correct wrong event dates.
    function isModifyingOnlyStaffEditableFields() {
      let protectedFields = ['totalCost', 'advancePaid', 'paymentStatus', 'paymentStatusValue', 'paymentStatusLabel', 'assignedTo', 'createdBy', 'createdAt', 'quotedAmount', 'quotedAt'];
      let modifiedFields = request.resource.data.diff(resource.data).affectedKeys();
      return !modifiedFields.hasAny(protectedFields);
    }

    // Stage / lost bookkeeping written by EnquiryRepository.updateStatus and the edit
    // form only together with a status change (EnquiryStageFields + LostReasonChoice).
    function statusBookkeepingFields() {
      return ['lostReason', 'lostReasonNote', 'lostAt', 'completedAt', 'inTalksAt', 'approvedAt', 'statusUpdatedBy'];
    }

    // Mirrors EnquiryStatus.legacyAliases. Re-saving a legacy doc from the edit form
    // rewrites statusValue to its canonical value without stamping anything.
    function legacyStatusAliases() {
      return {
        'contacted': 'in_talks',
        'quote_sent': 'in_talks',
        'quoted': 'in_talks',
        'in_progress': 'in_talks',
        'assigned': 'in_talks',
        'confirmed': 'approved',
        'scheduled': 'approved',
        'enquired': 'new',
        'not_intrested': 'not_interested'
      };
    }

    // Staff may only touch stage/lost fields in the same write as a real status change,
    // and that write must record them as the person who changed the status.
    function isStaffStatusBookkeepingValid() {
      let modifiedFields = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('statusValue', '');
      let newStatus = request.resource.data.get('statusValue', '');
      let statusChanging = modifiedFields.hasAny(['statusValue']);
      let isNormalisation = oldStatus is string
        && legacyStatusAliases().get(oldStatus, '') == newStatus;
      return (
          (!statusChanging || isNormalisation)
          && !modifiedFields.hasAny(statusBookkeepingFields())
        )
        || (
          statusChanging
          && !isNormalisation
          && request.resource.data.get('statusUpdatedBy', '') == request.auth.uid
        );
    }

    // Mirrors EnquiryStatus.staffTransitions (lib/core/constants/status_vocabulary.dart).
    // Legacy alias keys allow the same targets as their canonical status, plus the canonical
    // status itself so re-saving a legacy doc can normalise it. Terminal statuses
    // (completed, cancelled, closed_lost, not_interested) are absent: staff cannot move them.
    function staffStatusTransitions() {
      return {
        'new': ['in_talks', 'not_interested', 'cancelled'],
        'enquired': ['new', 'in_talks', 'not_interested', 'cancelled'],
        'in_talks': ['approved', 'not_interested', 'closed_lost', 'cancelled'],
        'contacted': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'quote_sent': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'quoted': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'in_progress': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'assigned': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'approved': ['completed', 'cancelled'],
        'confirmed': ['approved', 'completed', 'cancelled'],
        'scheduled': ['approved', 'completed', 'cancelled']
      };
    }

    function isAllowedStaffStatusChange() {
      let modifiedFields = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('statusValue', '');
      let newStatus = request.resource.data.get('statusValue', '');
      return !modifiedFields.hasAny(['statusValue'])
        || (oldStatus is string
          && newStatus in staffStatusTransitions().get(oldStatus, []));
    }

    // Public-ish profile (NO tokens here)
    // D6: active users may read colleague profiles (name/email/phone) — accepted 2026-07.
    // The owner can always read their own doc so the app can show "Access disabled".
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isActiveUser());
      allow create, update, delete: if isAdmin();
    }

    // NEW: Private per-user tokens (owner only)
    match /users/{uid}/private/notifications/tokens/{tid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User notifications — queued by NotificationService (runs as the acting app user) and
    // pushed by the sendNotificationToUser function. Keys/limits are a cross-agent contract.
    function isValidNotificationCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'body', 'type', 'data', 'enquiryId', 'read', 'createdAt', 'createdBy', 'senderId'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.body is string && d.body.size() > 0 && d.body.size() <= 500
        && (!('read' in d) || d.read == false)
        && (!('data' in d) || d.data is map)
        && (!('createdBy' in d) || d.createdBy == request.auth.uid)
        && (!('senderId' in d) || d.senderId == request.auth.uid);
    }

    // Owner reads; admins can read any. Owner may only flip read/readAt (markAsRead / markAll).
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isActiveUser() && isValidNotificationCreate();
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Enquiries - Admins see all, Staff only see assigned enquiries
    match /enquiries/{id} {
      // Read: Admins see all, Staff see only assigned enquiries
      allow read: if isAdmin()
        || (isStaff() && resource.data.assignedTo == request.auth.uid);
      
      // Create: Admin only
      allow create: if isAdmin();
      
      // Delete: Admin only (staff cannot delete enquiries)
      allow delete: if isAdmin();
      
      // Update: Admin can update anything, Staff can only update non-financial fields
      allow update: if isAdmin()
        || (
          // Staff can update if:
          // 1. They are assigned to the enquiry
          // 2. They are NOT modifying financial fields
          // 3. Any statusValue change follows the staff transition table
          isStaff()
          && resource.data.assignedTo == request.auth.uid
          && isModifyingOnlyStaffEditableFields()
          && isAllowedStaffStatusChange()
          && isStaffStatusBookkeepingValid()
        );
      
      // Enquiry History — append-only audit trail (AuditService writes `user_id`).
      // Cloud Functions write `user_id: 'system'` via the Admin SDK, bypassing rules.
      match /history/{historyId} {
        allow read: if isAdmin()
          || (isStaff() && get(/databases/$(database)/documents/enquiries/$(id)).data.assignedTo == request.auth.uid);
        allow create: if (isAdmin()
            || (isStaff() && get(/databases/$(database)/documents/enquiries/$(id)).data.assignedTo == request.auth.uid))
          && request.resource.data.user_id == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Contact log (calls / WhatsApp made from the app) — append-only.
      match /contacts/{contactId} {
        allow read: if isAdmin()
          || (isStaff() && get(/databases/$(database)/documents/enquiries/$(id)).data.assignedTo == request.auth.uid);
        allow create: if (isAdmin()
            || (isStaff() && get(/databases/$(database)/documents/enquiries/$(id)).data.assignedTo == request.auth.uid))
          && request.resource.data.by == request.auth.uid
          && request.resource.data.type in ['call', 'whatsapp', 'reminder', 'review_request'];
        allow update, delete: if false;
      }
    }

    // Per-user notifications (created by Cloud Functions)
    match /notifications/{uid}/items/{nid} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if isAdmin(); // created by CF with admin privileges
    }

    // Dropdowns - active users can read, admin can manage
    match /dropdowns/{group}/items/{value} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Analytics — admin-only, read-only (written by back-end jobs)
    match /analytics/{doc=**} {
      allow read: if isAdmin();
    }

    // User Settings - users can manage their own, admins can manage any
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    
    match /users/{uid}/settings/{docId} {
      allow read, write: if isSignedIn() && (isOwner(uid) || isAdmin());
    }

    // Per-user saved enquiry filter views (owner or admin)
    match /users/{uid}/savedViews/{viewId} {
      allow read, write: if isSignedIn() && (isOwner(uid) || isAdmin());
    }

    // App Config - read for active users, write for admins only
    match /app_config/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Admin Audit Trail - admins only (append-only forensic record)
    match /admin_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }
  }
}