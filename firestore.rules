rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    
    function isActiveUser() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData.get('isActive', userData.get('active', true)) == true;
    }

    function isAdmin() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // Check if user is staff (not admin)
    function isStaff() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "staff";
    }
    
    // Staff may read assigned enquiries; money is no longer on them (financial/summary,
    // admin only). Legacy money fields stay write-protected until migrated away.
    // eventDate stays staff-editable: the edit form lets staff correct wrong event dates.
    // Multi-function bookings: functions / functionCount / eventStartDate (and the synced
    // eventDate / eventType / location fields) are staff-editable on their own enquiry.
    // Yearly re-engagement stamp (occasionKind/Date/MonthDay/Manual) is admin + server only;
    // staff may edit occasionPerson and toggle occasionReminders (Yearly reminder card).
    // Allowlist of enquiry fields a staff member may modify on their own assigned
    // enquiry. Kept in sync with lib/core/constants/staff_editable_fields.dart
    // (enforced by test/core/constants/staff_editable_fields_test.dart).
    function staffEditableFields() {
      return [
        'customerName',
        'customerPhone',
        'customerEmail',
        'eventLocation',
        'locationPlaceId',
        'locationAddress',
        'locationLat',
        'locationLng',
        'locationArea',
        'locationCity',
        'eventType',
        'eventTypeValue',
        'eventTypeLabel',
        'eventDate',
        'functions',
        'functionCount',
        'eventStartDate',
        'notes',
        'description',
        'guestCount',
        'budgetRange',
        'source',
        'sourceValue',
        'sourceLabel',
        'priority',
        'priorityValue',
        'priorityLabel',
        'images',
        'statusValue',
        'statusLabel',
        'statusUpdatedAt',
        'statusUpdatedBy',
        'inTalksAt',
        'approvedAt',
        'completedAt',
        'lostAt',
        'lostReason',
        'lostReasonNote',
        'eventStatus',
        'status',
        'status_slug',
        'followUpDueAt',
        'followUpSeq',
        'followUpReason',
        'followUpNotifiedStage',
        'followUpScheduledBy',
        'followUpNote',
        'followUpLastCompletedAt',
        'followUpLastCompletedBy',
        'reminderClickCount',
        'lastReminderSentAt',
        'lastContactAt',
        'contactCount',
        'firstContactAt',
        'firstContactEstimated',
        'occasionPerson',
        'occasionReminders',
        'customerNameLower',
        'phoneNormalized',
        'textIndex',
        'updatedAt',
        'updatedBy'
      ];
    }

    function isModifyingOnlyStaffEditableFields() {
      let modifiedFields = request.resource.data.diff(resource.data).affectedKeys();
      return modifiedFields.hasOnly(staffEditableFields());
    }

    // Booking money lives in enquiries/{id}/financial/summary (admin only), because
    // Firestore cannot hide fields of a document staff may read. No client may add
    // or change these fields on the enquiry itself; removing them (migration) is fine.
    function enquiryMoneyFields() {
      return ['totalCost', 'advancePaid', 'paymentStatus', 'paymentStatusValue',
        'paymentStatusLabel', 'quotedAmount', 'quotedAt'];
    }

    function isNotWritingParentMoney() {
      let diff = request.resource.data.diff(resource.data);
      return !diff.addedKeys().hasAny(enquiryMoneyFields())
        && !diff.changedKeys().hasAny(enquiryMoneyFields());
    }

    // Stage / lost bookkeeping written by EnquiryRepository.updateStatus and the edit
    // form only together with a status change (EnquiryStageFields + LostReasonChoice).
    function statusBookkeepingFields() {
      return ['lostReason', 'lostReasonNote', 'lostAt', 'completedAt', 'inTalksAt', 'approvedAt', 'statusUpdatedBy'];
    }

    // Mirrors EnquiryStatus.legacyAliases. Re-saving a legacy doc from the edit form
    // rewrites statusValue to its canonical value without stamping anything.
    function legacyStatusAliases() {
      return {
        'contacted': 'in_talks',
        'quote_sent': 'in_talks',
        'quoted': 'in_talks',
        'in_progress': 'in_talks',
        'assigned': 'in_talks',
        'confirmed': 'approved',
        'scheduled': 'approved',
        'enquired': 'new',
        'not_intrested': 'not_interested'
      };
    }

    // Staff may only touch stage/lost fields in the same write as a real status change,
    // and that write must record them as the person who changed the status.
    function isStaffStatusBookkeepingValid() {
      let modifiedFields = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('statusValue', '');
      let newStatus = request.resource.data.get('statusValue', '');
      let statusChanging = modifiedFields.hasAny(['statusValue']);
      let isNormalisation = oldStatus is string
        && legacyStatusAliases().get(oldStatus, '') == newStatus;
      return (
          (!statusChanging || isNormalisation)
          && !modifiedFields.hasAny(statusBookkeepingFields())
        )
        || (
          statusChanging
          && !isNormalisation
          && request.resource.data.get('statusUpdatedBy', '') == request.auth.uid
        );
    }

    // Mirrors EnquiryStatus.staffTransitions (lib/core/constants/status_vocabulary.dart).
    // Legacy alias keys allow the same targets as their canonical status, plus the canonical
    // status itself so re-saving a legacy doc can normalise it. Terminal statuses
    // (completed, cancelled, closed_lost, not_interested) are absent: staff cannot move them.
    function staffStatusTransitions() {
      return {
        'new': ['in_talks', 'not_interested', 'cancelled'],
        'enquired': ['new', 'in_talks', 'not_interested', 'cancelled'],
        'in_talks': ['approved', 'not_interested', 'closed_lost', 'cancelled'],
        'contacted': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'quote_sent': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'quoted': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'in_progress': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'assigned': ['in_talks', 'approved', 'not_interested', 'closed_lost', 'cancelled'],
        'approved': ['completed', 'cancelled'],
        'confirmed': ['approved', 'completed', 'cancelled'],
        'scheduled': ['approved', 'completed', 'cancelled']
      };
    }

    function isAllowedStaffStatusChange() {
      let modifiedFields = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('statusValue', '');
      let newStatus = request.resource.data.get('statusValue', '');
      return !modifiedFields.hasAny(['statusValue'])
        || (oldStatus is string
          && newStatus in staffStatusTransitions().get(oldStatus, []));
    }

    // Approval requires a known location. Mirrors isVagueLocation / isLocationKnown in
    // lib/features/enquiries/domain/enquiry_location.dart (keep the name list in sync):
    // a value is vague when it is empty, only spaces / punctuation / symbols, or just
    // the city / state / country name ("Bangalore", "BLR.", "Bengaluru, Karnataka").
    function vagueLocationRegex() {
      return '(?i)[\\s\\p{Z}\\p{P}\\p{S}]*'
        + '((bangalore|bengaluru)([\\s\\p{Z}\\p{P}\\p{S}]+(city|urban|karnataka))?'
        + '|banglore|bangaluru|blr|karnataka|india)?'
        + '[\\s\\p{Z}\\p{P}\\p{S}]*';
    }

    function isKnownLocationValue(value) {
      return value is string && value.size() > 0 && !value.matches(vagueLocationRegex());
    }

    // Raw statusValues that mean Approved (canonical + legacyStatusAliases).
    function approvedStatusValues() {
      return ['approved', 'confirmed', 'scheduled'];
    }

    // An update moving the enquiry INTO Approved must leave a known location: a
    // non-vague locationArea or eventLocation. Re-saving a legacy approved alias
    // (confirmed → approved) and edits that don't change the status are unaffected.
    function hasLocationIfApproving() {
      let oldStatus = resource.data.get('statusValue', '');
      let newStatus = request.resource.data.get('statusValue', '');
      let approving = newStatus in approvedStatusValues()
        && !(oldStatus in approvedStatusValues());
      return !approving
        || isKnownLocationValue(request.resource.data.get('locationArea', ''))
        || isKnownLocationValue(request.resource.data.get('eventLocation', ''));
    }

    // Automatic follow-ups (functions/src/followUps*.ts, docs/IMPLEMENTATION_PLAN_2026-11.md).
    // The server schedules, cancels and records reminders. A client (admin or the
    // assignee, under the normal enquiry update rules) may only:
    //   complete   — followUpDueAt → null, completed by/at = self/now; or
    //   reschedule — a future followUpDueAt (≤ 400 days), reason callback/manual, by self;
    // each bumping followUpSeq by exactly one and clearing followUpNotifiedStage, so a
    // reminder for the old schedule can never fire. Reminder bookkeeping and the
    // past-event flag are server-only.
    function followUpFields() {
      return ['followUpDueAt', 'followUpSeq', 'followUpReason', 'followUpNotifiedStage',
        'followUpScheduledBy', 'followUpNote', 'followUpLastCompletedAt', 'followUpLastCompletedBy'];
    }

    function isFollowUpCompletion() {
      let d = request.resource.data;
      return d.get('followUpDueAt', null) == null
        && d.get('followUpLastCompletedBy', '') == request.auth.uid
        && d.get('followUpLastCompletedAt', null) == request.time;
    }

    function isFollowUpReschedule() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return d.get('followUpDueAt', null) is timestamp
        && d.followUpDueAt > request.time
        && d.followUpDueAt < request.time + duration.value(400, 'd')
        && d.get('followUpScheduledBy', '') == request.auth.uid
        && d.get('followUpReason', '') in ['callback', 'manual']
        && !changed.hasAny(['followUpLastCompletedAt', 'followUpLastCompletedBy']);
    }

    function isValidFollowUpChange() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return !changed.hasAny(['pastEventReviewAt', 'followUpLastNotifiedAt'])
        && (!changed.hasAny(followUpFields()) || (
          d.get('followUpSeq', 0) == resource.data.get('followUpSeq', 0) + 1
          && d.get('followUpNotifiedStage', null) == null
          && (d.get('followUpNote', null) == null
            || (d.followUpNote is string && d.followUpNote.size() <= 300))
          && (isFollowUpCompletion() || isFollowUpReschedule())
        ));
    }

    // Public-ish profile (NO tokens here)
    // D6: active users may read colleague profiles (name/email/phone) — accepted 2026-07.
    // The owner can always read their own doc so the app can show "Access disabled".
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isActiveUser());
      allow create, update, delete: if false;
    }

    // Colleague contact details (phone, email) — the owner and admins only. The
    // public users/{uid} doc keeps name, role and isActive for assignment labels.
    match /users/{uid}/private/profile {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin())
        && request.resource.data.keys().hasOnly(['phone', 'email', 'updatedAt']);
    }

    // NEW: Private per-user tokens (owner only)
    match /users/{uid}/private/notifications/tokens/{tid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User notifications — created ONLY by Cloud Functions (Admin SDK bypasses rules):
    // notifyEnquiryEvent (create / assign / status / edit, content built server-side),
    // websiteLead, autoExpireEnquiries, followUpReminders and re-engagement jobs.
    // sendNotificationToUser pushes each new doc. Clients can never create one, so a
    // signed-in user cannot push arbitrary text to a colleague (P0, Nov 2026 review).
    // Owner reads; admins can read any. Owner may only flip read/readAt (markAsRead / markAll).
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if false;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Enquiries - Admins see all, Staff only see assigned enquiries
    match /enquiries/{id} {
      // Read: Admins see all, Staff see only assigned enquiries
      allow read: if isAdmin()
        || (isStaff() && resource.data.assignedTo == request.auth.uid);
      
      // Create: Admin only, and never with money on the parent (see financial/summary).
      allow create: if isAdmin() && !request.resource.data.keys().hasAny(enquiryMoneyFields());
      
      // Delete: Admin only (staff cannot delete enquiries)
      allow delete: if isAdmin();
      
      // Update: Admin can update anything, Staff can only update non-financial fields
      // Both roles: moving into Approved needs a known location (hasLocationIfApproving);
      // follow-up fields change only as a valid complete / reschedule (isValidFollowUpChange).
      allow update: if hasLocationIfApproving() && isValidFollowUpChange()
        && isNotWritingParentMoney() && (isAdmin()
        || (
          // Staff can update if:
          // 1. They are assigned to the enquiry
          // 2. They are NOT modifying financial fields
          // 3. Any statusValue change follows the staff transition table
          isStaff()
          && resource.data.assignedTo == request.auth.uid
          && isModifyingOnlyStaffEditableFields()
          && isAllowedStaffStatusChange()
          && isStaffStatusBookkeepingValid()
        ));
      
      // Enquiry History — append-only audit trail (AuditService writes `user_id`).
      // Cloud Functions write `user_id: 'system'` via the Admin SDK, bypassing rules.
      function isValidHistoryValue(v) {
        return v == null
          || (v is string && v.size() <= 2000)
          || v is int
          || v is float
          || v is timestamp
          || v is bool;
      }

      match /history/{historyId} {
        allow read: if isAdmin()
          || (isStaff() && get(/databases/$(database)/documents/enquiries/$(id)).data.assignedTo == request.auth.uid);
        allow create: if (isAdmin()
            || (isStaff() && get(/databases/$(database)/documents/enquiries/$(id)).data.assignedTo == request.auth.uid))
          && request.resource.data.keys().hasOnly(['field_changed', 'old_value', 'new_value', 'user_id', 'timestamp', 'user_email'])
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.field_changed is string
          && request.resource.data.field_changed.size() > 0
          && request.resource.data.field_changed.size() <= 60
          && isValidHistoryValue(request.resource.data.get('old_value', null))
          && isValidHistoryValue(request.resource.data.get('new_value', null));
        allow update, delete: if false;
      }

      // Booking money (EnquiryFinancials): admins only. Staff can neither read nor write.
      match /financial/{docId} {
        allow read, write: if isAdmin();
      }

      // Contact log (calls / WhatsApp made from the app) — append-only.
      match /contacts/{contactId} {
        allow read: if isAdmin()
          || (isStaff() && get(/databases/$(database)/documents/enquiries/$(id)).data.assignedTo == request.auth.uid);
        allow create: if (isAdmin()
            || (isStaff() && get(/databases/$(database)/documents/enquiries/$(id)).data.assignedTo == request.auth.uid))
          && request.resource.data.by == request.auth.uid
          && request.resource.data.type in ['call', 'whatsapp', 'reminder', 'review_request', 'reengagement'];
        allow update, delete: if false;
      }

      // Line-item quotations (PDF quotes). Admin only — same privacy as money.
      match /quotations/{quoteId} {
        allow read, write: if isAdmin();
      }
    }

    // Shared catalog of quote line items (admin only).
    match /catalog/{itemId} {
      allow read, write: if isAdmin();
    }

    // Per-user notifications (created by Cloud Functions)
    match /notifications/{uid}/items/{nid} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if isAdmin(); // created by CF with admin privileges
    }

    // Dropdowns - active users can read, admin can manage
    // Group doc only carries the one-time `defaultsSeeded` marker (DropdownsRepository.repairGroup).
    match /dropdowns/{group} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
    }

    match /dropdowns/{group}/items/{value} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Collection-group reads of every financial summary (admin analytics / export).
    match /{path=**}/financial/{docId} {
      allow read: if isAdmin();
    }

    // Analytics — admin-only, read-only (written by back-end jobs)
    match /analytics/{doc=**} {
      allow read: if isAdmin();
    }

    // User Settings - users can manage their own, admins can manage any
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    
    match /users/{uid}/settings/{docId} {
      allow read, write: if isSignedIn() && (isOwner(uid) || isAdmin());
    }

    // Per-user saved enquiry filter views (owner or admin)
    match /users/{uid}/savedViews/{viewId} {
      allow read, write: if isSignedIn() && (isOwner(uid) || isAdmin());
    }

    // App Config - read for active users, write for admins only
    match /app_config/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Yearly re-engagement reminders at reminders/{phone}_{kind}_{year} — created and
    // deleted only by the scheduleReengagements function (Admin SDK). Admins see all;
    // staff see the ones assigned to them (assignedTo is null when the original handler
    // is inactive → admins only). Client updates: status + sent/skip bookkeeping only.
    function canActOnReminder() {
      return isAdmin()
        || (isActiveUser() && resource.data.assignedTo == request.auth.uid);
    }

    match /reminders/{reminderId} {
      allow read: if canActOnReminder();
      allow create, delete: if false;
      allow update: if canActOnReminder()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'sentAt', 'sentBy', 'skippedReason'])
        && request.resource.data.status in ['pending', 'sent', 'skipped']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sentBy'])
          || request.resource.data.sentBy == request.auth.uid)
        && (!('skippedReason' in request.resource.data)
          || request.resource.data.skippedReason == null
          || (request.resource.data.skippedReason is string
            && request.resource.data.skippedReason.size() <= 40));
    }

    // Per-customer preferences keyed by normalized phone ("Don't remind again").
    // Written only by the setReengagementPref function (caller must be an admin or
    // assigned to an enquiry with that phone); clients read.
    match /customer_prefs/{phone} {
      allow read: if isActiveUser();
      allow create, update, delete: if false;
    }

    // Admin Audit Trail - admins only (append-only forensic record)
    match /admin_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // Soft-deleted enquiries (admin-only trash + restore).
    match /enquiries_trash/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }
  }
}
