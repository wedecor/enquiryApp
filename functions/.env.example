# Copy to functions/.env (not committed) — the Firebase CLI loads it on deploy and in the emulator.
# NOTE: the "env" block under "functions" in firebase.json is IGNORED by the CLI; use this file.
#
# SMTP_PASS is NOT set here — it is a Secret Manager secret:
#   firebase functions:secrets:set SMTP_PASS
# (for Gmail use an App Password, not the account password)

# SMTP server host (default: smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# SMTP port: 587 = STARTTLS, 465 = implicit TLS (default: 587)
SMTP_PORT=587

# SMTP login user; invitation emails are skipped (link shown in the app) when empty
SMTP_USER=connect2wedecor@gmail.com

# From address for outbound mail (defaults to SMTP_USER)
SMTP_FROM_EMAIL=connect2wedecor@gmail.com
