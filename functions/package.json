{
  "name": "wedecor-functions",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "clean": "rimraf lib dist node_modules .turbo .parcel-cache .cache || true",
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "deploy": "firebase deploy --only functions:inviteUser,functions:adminUpdateUser,functions:autoExpireEnquiries,functions:sendNotificationToUser,functions:lookupCustomer,functions:setReengagementPref,functions:notifyEnquiryEvent,functions:onEnquiryWrittenFollowUp,functions:followUpReminders,functions:approvedOnDate,functions:scheduleReengagements,functions:runReengagementNow,functions:onEnquiryCompletedStampOccasion,functions:placesAutocomplete,functions:placeDetails,functions:websiteLead,functions:websiteFormOptions,functions:websitePlacesAutocomplete,functions:websitePlaceDetails",
    "lint": "echo \"(optional) add eslint if needed\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:test": "node -e \"require('fs').rmSync('lib-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test --test-concurrency=1 \"lib-test/test/**/*.test.js\"",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-functions-test \"npm test\""
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.6.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.14",
    "eslint": "^9.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
