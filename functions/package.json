{
  "name": "wedecor-functions",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "clean": "rimraf lib dist node_modules .turbo .parcel-cache .cache || true",
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "deploy": "firebase deploy --only functions:inviteUser,functions:adminUpdateUser,functions:autoExpireEnquiries,functions:sendNotificationToUser,functions:lookupCustomer,functions:approvedOnDate,functions:scheduleReengagements,functions:onEnquiryCompletedStampOccasion",
    "lint": "echo \"(optional) add eslint if needed\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.6.0",
    "nodemailer": "^6.9.8"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.14",
    "eslint": "^9.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
